# Copy to .env and adjust. Never commit the real .env.

DATABASE_URL=postgresql+psycopg://localhost/support_copilot

# "claude_cli" (default, $0 cost, needs `claude` CLI authenticated on PATH) or "api"
LLM_PROVIDER=claude_cli
CLAUDE_CLI_MODEL=sonnet
LLM_MODEL=anthropic/claude-sonnet-5

# Required only when LLM_PROVIDER=api
ANTHROPIC_API_KEY=
OPENAI_API_KEY=

LOCAL_EMBEDDING_MODEL=sentence-transformers/all-MiniLM-L6-v2

MAX_TOOL_ITERATIONS_PER_TICKET=6
MAX_TOKENS_PER_TICKET=20000
MAX_COST_USD_PER_TICKET=0.50

# Optional (Phase 2+)
LANGFUSE_PUBLIC_KEY=
LANGFUSE_SECRET_KEY=
LANGFUSE_HOST=https://cloud.langfuse.com

ACTIVE_EVAL_SET_VERSION=v1
ENVIRONMENT=dev
